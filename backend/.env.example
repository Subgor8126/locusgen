# Django Configuration
SECRET_KEY=your-secret-key-here
DEBUG=True
DJANGO_SETTINGS_MODULE=locusgen.settings.development

# Database Configuration
DB_NAME=locusgen_dev
DB_USER=locusgen
DB_PASSWORD=locusgen_dev_password
DB_HOST=localhost
DB_PORT=5432
USE_SQLITE=False

# AWS Cognito Configuration
AWS_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
AWS_COGNITO_APP_CLIENT_ID=your_cognito_client_id_here
AWS_REGION=us-east-1

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production Settings (for production environment)
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
USE_S3=False
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=locusgen-3d-models-dev
AWS_S3_REGION_NAME=us-east-1