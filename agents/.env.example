# LocusGen Agent System Environment Variables

# Model Configuration
LOCUSGEN_MODEL_ID=amazon.nova-pro-v1:0
LOCUSGEN_MAX_TOKENS=4000
LOCUSGEN_TEMPERATURE=0.7

# Environment Settings
LOCUSGEN_ENVIRONMENT=development
LOCUSGEN_DEBUG_MODE=true
LOCUSGEN_LOG_LEVEL=INFO

# AWS Configuration
AWS_REGION=us-east-1
# Note: AWS credentials handled via IAM roles in production
# For local development, use AWS CLI profiles or temporary credentials
BEDROCK_RUNTIME_ENDPOINT=

# Django Backend Integration
DJANGO_BACKEND_URL=http://localhost:8000
DJANGO_API_KEY=

# MCP Server Configuration
MCP_SKETCHFAB_API_KEY=your_sketchfab_api_key_here

# CDN Tool Configuration
S3_BUCKET_NAME=locusgen-3d-models-dev
DYNAMODB_TABLE_NAME=locusgen-assets-dev

# Logging and Monitoring
LOG_FILE_PATH=agents.log
ENABLE_STRUCTURED_LOGGING=true
SENTRY_DSN=